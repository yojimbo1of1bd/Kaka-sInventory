# ==============================================================================
# PROJECT KAKA - PRODUCTION ANDROID .GITIGNORE
# ==============================================================================

# ── 1. Built Application Binaries & Packages ──────────────────────────────────
*.apk
*.ap_
*.aab
*.dex
*.aar
app-debug.apk
app-release.apk
app-release-unsigned.apk

# ── 2. Java / Kotlin Compiled Outputs ─────────────────────────────────────────
*.class
bin/

# ── 3. Gradle & Project Build Outputs ─────────────────────────────────────────
build/
**/build/
app/build/
.gradle/
.kotlin/
.incremental/

# ── 4. Standalone Gradle Distributions & Archives ────────────────────────────
# Never commit full downloaded Gradle distributions or wrapper zip caches
gradle-*.zip
gradle-*/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ── 5. Local Machine SDK & Machine-Specific Config ────────────────────────────
# Contains absolute local SDK paths (e.g., C:\Users\...\Android\Sdk)
local.properties

# ── 6. Android Studio & IntelliJ IDEA Workspace ───────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# Android Studio Navigation editor & layout temporary files
.navigation/

# ── 7. Logs, Memory Dumps & Profiler Traces ───────────────────────────────────
*.log
*.log.*
captures/
profiler-*.trace
*.hprof

# ── 8. Keystores, Signing Keys & Private Credentials ──────────────────────────
# CRITICAL: Never commit private release/debug keystores or credentials
*.jks
*.keystore
signing.properties
release.keystore
debug.keystore

# ── 9. Cloud Secrets & Google Services ────────────────────────────────────────
google-services.json
secrets.properties

# ── 10. Native C/C++ NDK Builds ───────────────────────────────────────────────
.externalNativeBuild/
.cxx/

# ── 11. Test & Lint Reports ───────────────────────────────────────────────────
lint/
**/reports/
**/test-results/

# ── 12. Agentic IDE State & Temporary Workspaces ─────────────────────────────
.agents/
.system_generated/

# ── 13. Archives & Temporary Swap Files ───────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.swp
*~

# ── 14. OS-Generated Metadata & Cache Files ───────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# ── 15. VS Code & Alternative Editors ─────────────────────────────────────────
.vscode/
.history/
