<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kaka_inventory.db" />
        <include domain="file" path="kaka_webp_store" />
    </device-transfer>
</data-extraction-rules>
